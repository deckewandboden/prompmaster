FROM golang:1.27.3-alpine3.23 AS build
ENV GOTOOLCHAIN=local

ARG POSTGRES_EXPORTER_COMMIT=867fbcac31cd18c143e244190ea9168cca069827

RUN --mount=type=secret,id=pf_staging_ca,required=false \
    if [ -s /run/secrets/pf_staging_ca ]; then \
      cat /etc/ssl/cert.pem /run/secrets/pf_staging_ca > /tmp/pf-staging-ca-combined.pem; \
      export SSL_CERT_FILE=/tmp/pf-staging-ca-combined.pem; \
      export GIT_SSL_CAINFO=/tmp/pf-staging-ca-combined.pem; \
      export CURL_CA_BUNDLE=/tmp/pf-staging-ca-combined.pem; \
      trap 'rm -f /tmp/pf-staging-ca-combined.pem' EXIT; \
    fi; \
    apk add --no-cache git ca-certificates \
    && git clone https://github.com/prometheus-community/postgres_exporter.git /src \
    && cd /src \
    && git checkout "$POSTGRES_EXPORTER_COMMIT" \
    && test "$(git rev-parse HEAD)" = "$POSTGRES_EXPORTER_COMMIT"

WORKDIR /src
RUN --mount=type=secret,id=pf_staging_ca,required=false \
    if [ -s /run/secrets/pf_staging_ca ]; then \
      cat /etc/ssl/cert.pem /run/secrets/pf_staging_ca > /tmp/pf-staging-ca-combined.pem; \
      export SSL_CERT_FILE=/tmp/pf-staging-ca-combined.pem; \
      export GIT_SSL_CAINFO=/tmp/pf-staging-ca-combined.pem; \
      export CURL_CA_BUNDLE=/tmp/pf-staging-ca-combined.pem; \
      trap 'rm -f /tmp/pf-staging-ca-combined.pem' EXIT; \
    fi; \
    go get golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.60.0 \
    && go mod tidy \
    && CGO_ENABLED=0 GOOS=linux go build \
       -trimpath \
       -ldflags="-s -w -X github.com/prometheus/common/version.Version=0.20.1 -X github.com/prometheus/common/version.Revision=$POSTGRES_EXPORTER_COMMIT" \
       -o /out/postgres_exporter ./cmd/postgres_exporter \
    && go version -m /out/postgres_exporter | grep -F 'go1.27.3' \
    && go version -m /out/postgres_exporter | grep -F 'golang.org/x/net' | grep -F 'v0.60.0'

FROM prometheuscommunity/postgres-exporter:v0.20.1
USER root
COPY --from=build /out/postgres_exporter /bin/postgres_exporter
USER nobody
