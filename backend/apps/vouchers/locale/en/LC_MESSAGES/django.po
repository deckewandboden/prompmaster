msgid "Gutscheine & Aktionen"
msgstr "Vouchers & promotions"

msgid "Rabatte und kostenlose Pro-Zeiträume sicher verwalten."
msgstr "Manage discounts and complimentary Pro periods securely."

msgid "+ Codes erstellen"
msgstr "+ Create codes"

msgid "Kampagnencodes"
msgstr "Campaign codes"

msgid "Erfolgreiche Einlösungen"
msgstr "Successful redemptions"

msgid "Kampagne, Firma oder letzte vier Zeichen"
msgstr "Campaign, company, or last four characters"

msgid "Prozent"
msgstr "Percent"

