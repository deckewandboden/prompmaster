msgstr "Bon"

msgid "Laufzeit/Rabatt"
msgstr "Durée/réduction"

msgid "Kampagnenbezeichnung"
msgstr "Nom de la campagne"

msgid "Interner Hinweis"
msgstr "Note interne"

msgid "Rabatt in Prozent"
msgstr "Remise en pourcentage"

msgid "Festbetrag je Lizenz"
msgstr "Montant fixe par licence"

msgid "Kostenlose Pro-Nutzung"
msgstr "Accès Pro gratuit"

msgid "Gutscheinart"
msgstr "Type de bon"

