msgstr "Utilisateur uniquement (facultatif)"

msgid "Prozentgutscheine benötigen 1–99 Prozent."
msgstr "Les bons en pourcentage doivent être compris entre 1 et 99 %."

msgid "Festbetrag muss größer null sein."
msgstr "Le montant fixe doit être supérieur à zéro."

msgid "Kostenlose Laufzeit muss 1–1095 Tage betragen."
msgstr "La durée gratuite doit être comprise entre 1 et 1095 jours."

msgid "Nur für Prozentgutscheine zulässig."
msgstr "Autorisé uniquement pour les bons en pourcentage."

msgid "Nur für Festbetragsgutscheine zulässig."
msgstr "Autorisé uniquement pour les bons à montant fixe."

msgid "Nur für Zeitgutscheine zulässig."
msgstr "Autorisé uniquement pour les bons de durée."

msgid "Bei Zeitgutscheinen nicht anwendbar."
msgstr "Non applicable aux bons de durée."

msgid "Entweder Unternehmen oder Benutzer binden."
msgstr "Restreindre à une entreprise ou à un utilisateur."

msgid "Das Ende muss nach dem Beginn liegen."
msgstr "La fin doit être postérieure au début."

msgid "Maximale Einlösungen"
msgstr "Nombre maximal d'utilisations"

msgid "Bereits reservierte Einlösungen dürfen nicht abgeschnitten werden."
msgstr "La limite ne peut pas être inférieure aux réservations existantes."

msgid "Das Ende muss nach Beginn liegen."
msgstr "La fin doit être postérieure au début."

msgid "Neue Gutscheincodes"
msgstr "Nouveaux codes de réduction"

msgid "Gutscheine erstellen"
msgstr "Créer des bons"

msgid "Gutschein aktualisiert."
msgstr "Bon mis à jour."

msgid "Gutscheinstatus geändert. Bestehende Nutzungsrechte bleiben unverändert."
msgstr "Statut du bon modifié. Les droits d'accès existants restent inchangés."

#, python-format
msgid "Gutschein eingelöst. Pro-Lizenz: %(license)s"
msgstr "Bon utilisé. Licence Pro : %(license)s"

msgid "Ungültige Lizenzanzahl."
msgstr "Quantité de licences invalide."

msgid "Gutschein oder Preis nicht verfügbar."
msgstr "Bon ou prix indisponible."

msgid "Festbetrag ist für diese Währung nicht zulässig."
msgstr "La réduction fixe n'est pas autorisée pour cette devise."

msgid "Bitte den Gutschein im Kundenportal einlösen."
msgstr "Veuillez utiliser le bon dans le portail client."

msgid "Gutschein ungültig oder nicht verfügbar."
msgstr "Code invalide ou indisponible."

msgid "Gutscheincode ungültig oder nicht verfügbar."
msgstr "Code de réduction invalide ou indisponible."

msgid "Nur netstyle kann Gutscheine erstellen."
msgstr "Seul netstyle peut créer des bons."

msgid "Pro Aktion sind 1 bis 100 Gutscheine zulässig."
msgstr "Chaque opération peut créer de 1 à 100 bons."

msgid "Gutschein nicht verfügbar oder abgelaufen."
msgstr "Bon indisponible ou expiré."

msgid "Dieser Gutschein ist bereits vollständig eingelöst."
msgstr "Le nombre maximal d'utilisations de ce bon est atteint."

msgid "Dieser Gutschein gilt nicht für das gewählte Produkt."
msgstr "Ce bon n'est pas valable pour le produit choisi."

msgid "Deaktivierte Unternehmen können keine Gutscheine einlösen."
msgstr "Les entreprises désactivées ne peuvent pas utiliser de bons."

msgid "Gutschein ist für einen anderen Kunden ausgestellt."
msgstr "Ce bon est réservé à un autre client."

msgid "Gutschein ist für einen anderen Benutzer ausgestellt."
msgstr "Ce bon est réservé à un autre utilisateur."

msgid "Gutschein gilt nur für neue Pro-Lizenzen."
msgstr "Ce bon est réservé aux nouvelles licences Pro."

msgid "Dieser Benutzer hat den Gutschein bereits eingelöst."
msgstr "Cet utilisateur a déjà utilisé ce bon."

msgid "Dieser Gutschein wurde von diesem Konto bereits genutzt."
msgstr "Ce compte a déjà utilisé ce bon."

msgid "Kostenlose Zeitgutscheine bitte im Gutscheinbereich einlösen."
msgstr "Utilisez les bons de durée gratuite dans la section dédiée."

msgid "Gutscheinbetrag ist für diesen Lizenzpreis nicht zulässig."
msgstr "Le montant du bon ne convient pas à ce prix de licence."

msgid "Gutschein darf nur für eine zahlungspflichtige Bestellung verwendet werden."
msgstr "Le bon ne peut être utilisé que pour une commande payante."

msgid "Gutscheinreservierung kann wegen inkonsistentem Kontingent nicht freigegeben werden."
msgstr "Impossible de libérer la réservation en raison d'un quota incohérent."

msgid "Bitte ein aktives, bestätigtes Kundenkonto verwenden."
msgstr "Utilisez un compte client actif et vérifié."

msgid "Pro ist derzeit nicht verfügbar."
msgstr "Pro est actuellement indisponible."

msgid "Nur der Firmenadministrator kann Zeitgutscheine einlösen."
msgstr "Seul l'administrateur de l'entreprise peut utiliser des bons de durée."

msgid "Empfänger muss aktives, bestätigtes Firmenmitglied sein."
msgstr "Le bénéficiaire doit être un membre actif et vérifié de l'entreprise."

msgid "Privatcodes sind ausschließlich für das eigene Konto."
msgstr "Les codes privés ne peuvent être utilisés que sur le compte du titulaire."

msgid "Ein Privatkundenkonto ist erforderlich."
msgstr "Un compte client particulier est nécessaire."

msgid "Persönliche Zeitgutscheine müssen direkt dem vorgesehenen Benutzer zugewiesen werden."
msgstr "Les bons de durée personnels doivent être attribués directement à l'utilisateur désigné."

msgid "Rabattgutscheine bitte beim Pro-Kauf verwenden."
msgstr "Utilisez les bons de réduction lors de l'achat de Pro."

msgid "Für Pro fehlt die Preisversion; Gutschein kann nicht gebucht werden."
msgstr "Il manque la version tarifaire de Pro ; le bon ne peut pas être enregistré."

msgid "Für diesen Benutzer besteht eine gesperrte oder zu prüfende Pro-Lizenz."
msgstr "Cet utilisateur possède une licence Pro bloquée ou en cours de vérification."

msgid "Rabattprozente müssen zwischen 1 und 99 liegen."
msgstr "Le pourcentage de réduction doit être compris entre 1 et 99."

msgid "Ein positiver Festbetrag ist erforderlich."
msgstr "Un montant fixe positif est requis."

msgid "Kostenlose Laufzeit muss 1 bis 1095 Tage betragen."
msgstr "La durée gratuite doit être comprise entre 1 et 1095 jours."

msgid "Rabattcodes dürfen keine freie Laufzeit haben."
msgstr "Les codes de réduction ne peuvent pas accorder de période gratuite."

msgid "Nur Festbetragsrabatte dürfen einen Betrag haben."
msgstr "Seuls les bons à montant fixe peuvent avoir un montant."

msgid "Nur Prozentcodes dürfen Rabattprozente haben."
msgstr "Seuls les bons en pourcentage peuvent définir un pourcentage."

msgid "Probezeiträume sind keine Zahlungsrabatte."
msgstr "Les périodes d'essai ne sont pas des réductions de paiement."

msgid "Ein Code kann nur auf Firma oder Benutzer begrenzt sein."
msgstr "Un code peut être réservé à une entreprise ou à un utilisateur, pas aux deux."

msgid "Ende muss nach Beginn liegen."
msgstr "La fin doit être postérieure au début."

msgid "Mindestens eine Einlösung erforderlich."
msgstr "Au moins une utilisation est requise."

msgid "Prozentualer Rabatt"
msgstr "Réduction en pourcentage"

msgid "Fester Rabatt je Lizenz"
msgstr "Réduction fixe par licence"

msgid "Kostenlose Pro-Laufzeit"
msgstr "Période Pro gratuite"

msgid "Für Bestellung reserviert"
msgstr "Réservé pour la commande"

msgid "Eingelöst"
msgstr "Utilisé"

