msgstr "Buono aggiornato."

msgid "Gutscheinstatus geändert. Bestehende Nutzungsrechte bleiben unverändert."
msgstr "Stato del buono modificato. I diritti di accesso esistenti rimangono invariati."

#, python-format
msgid "Gutschein eingelöst. Pro-Lizenz: %(license)s"
msgstr "Buono riscattato. Licenza Pro: %(license)s"

msgid "Ungültige Lizenzanzahl."
msgstr "Quantità di licenze non valida."

msgid "Gutschein oder Preis nicht verfügbar."
msgstr "Buono o prezzo non disponibile."

msgid "Festbetrag ist für diese Währung nicht zulässig."
msgstr "Lo sconto fisso non è consentito per questa valuta."

msgid "Bitte den Gutschein im Kundenportal einlösen."
msgstr "Riscatta il buono nel portale clienti."

msgid "Gutschein ungültig oder nicht verfügbar."
msgstr "Codice non valido o non disponibile."

msgid "Gutscheincode ungültig oder nicht verfügbar."
msgstr "Codice sconto non valido o non disponibile."

msgid "Nur netstyle kann Gutscheine erstellen."
msgstr "Solo netstyle può creare buoni."

msgid "Pro Aktion sind 1 bis 100 Gutscheine zulässig."
msgstr "Per ogni operazione sono consentiti da 1 a 100 buoni."

msgid "Gutschein nicht verfügbar oder abgelaufen."
msgstr "Buono non disponibile o scaduto."

msgid "Dieser Gutschein ist bereits vollständig eingelöst."
msgstr "Il limite di utilizzi di questo buono è esaurito."

msgid "Dieser Gutschein gilt nicht für das gewählte Produkt."
msgstr "Questo buono non vale per il prodotto selezionato."

msgid "Deaktivierte Unternehmen können keine Gutscheine einlösen."
msgstr "Le aziende disattivate non possono riscattare buoni."

msgid "Gutschein ist für einen anderen Kunden ausgestellt."
msgstr "Il buono è destinato a un altro cliente."

msgid "Gutschein ist für einen anderen Benutzer ausgestellt."
msgstr "Il buono è destinato a un altro utente."

msgid "Gutschein gilt nur für neue Pro-Lizenzen."
msgstr "Il buono vale solo per nuove licenze Pro."

msgid "Dieser Benutzer hat den Gutschein bereits eingelöst."
msgstr "Questo utente ha già riscattato il buono."

msgid "Dieser Gutschein wurde von diesem Konto bereits genutzt."
msgstr "Questo account ha già utilizzato il buono."

msgid "Kostenlose Zeitgutscheine bitte im Gutscheinbereich einlösen."
msgstr "Riscatta i buoni per periodi gratuiti nella sezione buoni."

msgid "Gutscheinbetrag ist für diesen Lizenzpreis nicht zulässig."
msgstr "L'importo del buono non è valido per questo prezzo di licenza."

msgid "Gutschein darf nur für eine zahlungspflichtige Bestellung verwendet werden."
msgstr "Il buono può essere applicato solo a un ordine a pagamento."

msgid "Gutscheinreservierung kann wegen inkonsistentem Kontingent nicht freigegeben werden."
msgstr "Impossibile liberare la prenotazione per incoerenza della quota."

msgid "Bitte ein aktives, bestätigtes Kundenkonto verwenden."
msgstr "Utilizza un account cliente attivo e verificato."

msgid "Pro ist derzeit nicht verfügbar."
msgstr "Pro non è attualmente disponibile."

msgid "Nur der Firmenadministrator kann Zeitgutscheine einlösen."
msgstr "Solo l'amministratore aziendale può riscattare buoni a tempo."

msgid "Empfänger muss aktives, bestätigtes Firmenmitglied sein."
msgstr "Il destinatario deve essere un membro aziendale attivo e verificato."

msgid "Privatcodes sind ausschließlich für das eigene Konto."
msgstr "I codici privati si possono usare solo sul proprio account."

msgid "Ein Privatkundenkonto ist erforderlich."
msgstr "È necessario un account cliente privato."

msgid "Persönliche Zeitgutscheine müssen direkt dem vorgesehenen Benutzer zugewiesen werden."
msgstr "I buoni personali a tempo devono essere assegnati direttamente all'utente previsto."

msgid "Rabattgutscheine bitte beim Pro-Kauf verwenden."
msgstr "Usa i buoni sconto durante l'acquisto di Pro."

msgid "Für Pro fehlt die Preisversion; Gutschein kann nicht gebucht werden."
msgstr "Manca la versione del prezzo di Pro; il buono non può essere registrato."

msgid "Für diesen Benutzer besteht eine gesperrte oder zu prüfende Pro-Lizenz."
msgstr "Questo utente ha una licenza Pro bloccata o in verifica."

msgid "Rabattprozente müssen zwischen 1 und 99 liegen."
msgstr "La percentuale di sconto deve essere tra 1 e 99."

msgid "Ein positiver Festbetrag ist erforderlich."
msgstr "È richiesto un importo fisso positivo."

msgid "Kostenlose Laufzeit muss 1 bis 1095 Tage betragen."
msgstr "La durata gratuita deve essere compresa tra 1 e 1095 giorni."

msgid "Rabattcodes dürfen keine freie Laufzeit haben."
msgstr "I codici sconto non possono concedere periodi gratuiti."

msgid "Nur Festbetragsrabatte dürfen einen Betrag haben."
msgstr "Solo i buoni a importo fisso possono specificare un importo."

msgid "Nur Prozentcodes dürfen Rabattprozente haben."
msgstr "Solo i buoni percentuali possono specificare una percentuale."

msgid "Probezeiträume sind keine Zahlungsrabatte."
msgstr "I periodi di prova non sono sconti sul pagamento."

msgid "Ein Code kann nur auf Firma oder Benutzer begrenzt sein."
msgstr "Un codice può essere vincolato a un'azienda o a un utente, non a entrambi."

msgid "Ende muss nach Beginn liegen."
msgstr "La fine deve essere successiva all'inizio."

msgid "Mindestens eine Einlösung erforderlich."
msgstr "È richiesto almeno un riscatto."

