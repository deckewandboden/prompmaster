msgid "Prozentgutscheine benötigen 1–99 Prozent."
msgstr "I buoni percentuali richiedono un valore tra 1 e 99 per cento."

msgid "Festbetrag muss größer null sein."
msgstr "L'importo fisso deve essere maggiore di zero."

msgid "Kostenlose Laufzeit muss 1–1095 Tage betragen."
msgstr "La durata gratuita deve essere compresa tra 1 e 1095 giorni."

msgid "Nur für Prozentgutscheine zulässig."
msgstr "Consentito solo per buoni percentuali."

msgid "Nur für Festbetragsgutscheine zulässig."
msgstr "Consentito solo per buoni a importo fisso."

msgid "Nur für Zeitgutscheine zulässig."
msgstr "Consentito solo per buoni a tempo."

msgid "Bei Zeitgutscheinen nicht anwendbar."
msgstr "Non applicabile ai buoni a tempo."

msgid "Entweder Unternehmen oder Benutzer binden."
msgstr "Limita a un'azienda oppure a un utente."

msgid "Das Ende muss nach dem Beginn liegen."
msgstr "La fine deve essere successiva all'inizio."

msgid "Maximale Einlösungen"
msgstr "Numero massimo di riscatti"

msgid "Bereits reservierte Einlösungen dürfen nicht abgeschnitten werden."
msgstr "Il limite non può essere inferiore alle prenotazioni esistenti."

msgid "Das Ende muss nach Beginn liegen."
msgstr "La fine deve essere successiva all'inizio."

