msgid "Gutschein eingelöst. Pro-Lizenz: %(license)s"
msgstr "Kupon kullanıldı. Pro lisansı: %(license)s"

msgid "Ungültige Lizenzanzahl."
msgstr "Geçersiz lisans adedi."

msgid "Gutschein oder Preis nicht verfügbar."
msgstr "Kupon veya fiyat kullanılamıyor."

msgid "Festbetrag ist für diese Währung nicht zulässig."
msgstr "Sabit indirim bu para biriminde geçerli değildir."

msgid "Bitte den Gutschein im Kundenportal einlösen."
msgstr "Lütfen kuponu müşteri portalında kullanın."

msgid "Gutschein ungültig oder nicht verfügbar."
msgstr "Kupon geçersiz veya kullanılamıyor."

msgid "Gutscheincode ungültig oder nicht verfügbar."
msgstr "Kupon kodu geçersiz veya kullanılamıyor."

msgid "Nur netstyle kann Gutscheine erstellen."
msgstr "Kuponları yalnızca netstyle oluşturabilir."

msgid "Pro Aktion sind 1 bis 100 Gutscheine zulässig."
msgstr "Her işlemde 1 ila 100 kupon oluşturulabilir."

msgid "Gutschein nicht verfügbar oder abgelaufen."
msgstr "Kupon kullanılamıyor veya süresi dolmuş."

msgid "Dieser Gutschein ist bereits vollständig eingelöst."
msgstr "Bu kuponun tüm kullanım hakkı tükenmiş."

msgid "Dieser Gutschein gilt nicht für das gewählte Produkt."
msgstr "Bu kupon seçilen ürün için geçerli değil."

msgid "Deaktivierte Unternehmen können keine Gutscheine einlösen."
msgstr "Devre dışı şirketler kupon kullanamaz."

msgid "Gutschein ist für einen anderen Kunden ausgestellt."
msgstr "Kupon başka bir müşteri için düzenlenmiş."

msgid "Gutschein ist für einen anderen Benutzer ausgestellt."
msgstr "Kupon başka bir kullanıcı için düzenlenmiş."

msgid "Gutschein gilt nur für neue Pro-Lizenzen."
msgstr "Kupon yalnızca yeni Pro lisansları için geçerlidir."

msgid "Dieser Benutzer hat den Gutschein bereits eingelöst."
msgstr "Bu kullanıcı kuponu zaten kullandı."

msgid "Dieser Gutschein wurde von diesem Konto bereits genutzt."
msgstr "Bu hesap kuponu zaten kullandı."

msgid "Kostenlose Zeitgutscheine bitte im Gutscheinbereich einlösen."
msgstr "Ücretsiz süre kuponlarını kupon bölümünde kullanın."

msgid "Gutscheinbetrag ist für diesen Lizenzpreis nicht zulässig."
msgstr "Kupon tutarı bu lisans fiyatı için geçerli değil."

msgid "Gutschein darf nur für eine zahlungspflichtige Bestellung verwendet werden."
msgstr "Kupon yalnızca ücretli bir siparişte kullanılabilir."

msgid "Gutscheinreservierung kann wegen inkonsistentem Kontingent nicht freigegeben werden."
msgstr "Kontenjan tutarsızlığı nedeniyle kupon rezervasyonu serbest bırakılamıyor."

msgid "Bitte ein aktives, bestätigtes Kundenkonto verwenden."
msgstr "Lütfen etkin ve doğrulanmış müşteri hesabı kullanın."

msgid "Pro ist derzeit nicht verfügbar."
msgstr "Pro şu anda kullanılamıyor."

msgid "Nur der Firmenadministrator kann Zeitgutscheine einlösen."
msgstr "Süre kuponlarını yalnızca şirket yöneticisi kullanabilir."

msgid "Empfänger muss aktives, bestätigtes Firmenmitglied sein."
msgstr "Alıcı etkin ve doğrulanmış bir şirket üyesi olmalıdır."

msgid "Privatcodes sind ausschließlich für das eigene Konto."
msgstr "Özel kodlar yalnızca kendi hesabında kullanılabilir."

msgid "Ein Privatkundenkonto ist erforderlich."
msgstr "Bireysel müşteri hesabı gereklidir."

msgid "Persönliche Zeitgutscheine müssen direkt dem vorgesehenen Benutzer zugewiesen werden."
msgstr "Kişisel süre kuponları doğrudan ilgili kullanıcıya atanmalıdır."

msgid "Rabattgutscheine bitte beim Pro-Kauf verwenden."
msgstr "İndirim kuponlarını Pro satın alırken kullanın."

msgid "Für Pro fehlt die Preisversion; Gutschein kann nicht gebucht werden."
msgstr "Pro fiyat sürümü eksik; kupon işlenemiyor."

msgid "Für diesen Benutzer besteht eine gesperrte oder zu prüfende Pro-Lizenz."
msgstr "Bu kullanıcıya ait engellenmiş veya incelemede olan bir Pro lisansı var."

msgid "Rabattprozente müssen zwischen 1 und 99 liegen."
msgstr "İndirim yüzdesi 1 ile 99 arasında olmalıdır."

msgid "Ein positiver Festbetrag ist erforderlich."
msgstr "Pozitif bir sabit tutar gereklidir."

msgid "Kostenlose Laufzeit muss 1 bis 1095 Tage betragen."
msgstr "Ücretsiz süre 1 ile 1095 gün arasında olmalıdır."

msgid "Rabattcodes dürfen keine freie Laufzeit haben."
msgstr "İndirim kodları ücretsiz süre veremez."

msgid "Nur Festbetragsrabatte dürfen einen Betrag haben."
msgstr "Yalnızca sabit tutarlı kuponlarda tutar belirtilebilir."

msgid "Nur Prozentcodes dürfen Rabattprozente haben."
msgstr "Yalnızca yüzde kuponlarında yüzde belirtilebilir."

msgid "Probezeiträume sind keine Zahlungsrabatte."
msgstr "Deneme süreleri ödeme indirimi değildir."

msgid "Ein Code kann nur auf Firma oder Benutzer begrenzt sein."
msgstr "Kod şirket veya kullanıcıyla sınırlandırılabilir; ikisi birden olamaz."

msgid "Ende muss nach Beginn liegen."
msgstr "Bitiş başlangıçtan sonra olmalıdır."

msgid "Mindestens eine Einlösung erforderlich."
msgstr "En az bir kullanım gereklidir."

