msgstr "Doelbinding"

msgid "Alle berechtigten Kunden"
msgstr "Alle in aanmerking komende klanten"

msgid "Bereits gewährte Lizenzen werden durch Gutscheinsperrung nicht automatisch entzogen."
msgstr "Het blokkeren van een code trekt eerder toegekende licenties niet automatisch in."

msgid "Code für weitere Einlösungen sperren"
msgstr "Code blokkeren voor verdere inwisseling"

msgid "Code wieder aktivieren"
msgstr "Code opnieuw activeren"

msgid "Kampagne bearbeiten"
msgstr "Actie bewerken"

msgid "Die wirtschaftlichen Konditionen und Kundenbindung bleiben nach Ausstellung unveränderlich."
msgstr "Financiële voorwaarden en klantbinding kunnen na uitgifte niet meer worden gewijzigd."

msgid "Einlösehistorie"
msgstr "Inwisselgeschiedenis"

msgid "Einlöser"
msgstr "Ingewisseld door"

msgid "Lizenz/Bestellung"
msgstr "Licentie/bestelling"

msgid "Noch keine Einlösungen."
msgstr "Nog geen inwisselingen."

msgid "Gutscheine & Gratislaufzeiten"
msgstr "Kortingscodes en gratis periodes"

msgid "Rabattcodes beim Lizenzkauf nutzen oder Pro-Zeiträume einlösen."
msgstr "Gebruik kortingscodes bij de aankoop van licenties of wissel gratis Pro-periodes in."

msgid "Kostenlose Pro-Laufzeit einlösen"
msgstr "Gratis Pro-periode inwisselen"

msgid "Zeitgutscheine können neue Lizenzen erzeugen oder die bestehende Lizenz des Empfängers verlängern. Rabattcodes gehören in das Kaufformular."
msgstr "Tijdcodes maken nieuwe licenties aan of verlengen de bestaande licentie van de ontvanger. Vul kortingscodes in bij het afrekenen."

msgid "Unzugewiesene Lizenz für mein Unternehmen"
msgstr "Niet-toegewezen licentie voor mijn bedrijf"

msgid "Zeitgutschein verbindlich einlösen"
msgstr "Tijdcode inwisselen"

msgid "Für dieses Konto zugeteilte Kampagnen"
msgstr "Acties toegewezen aan dit account"

msgid "Vollständige Codes werden nur durch netstyle ausgegeben."
msgstr "Volledige codes worden uitsluitend door netstyle uitgegeven."

msgid "Keine ausdrücklich zugeteilten Kampagnen."
msgstr "Geen acties specifiek aan dit account toegewezen."

msgid "Rabatt bei der Bestellung"
msgstr "Korting op de bestelling"

msgid "Rabattcodes werden beim Kauf oder bei zulässigen Verlängerungen vor der Zahlung geprüft und auf den Bruttopreis angewendet."
msgstr "Kortingscodes worden vóór betaling gecontroleerd bij aankoop of toegestane verlenging en toegepast op de brutoprijs."

msgid "Zum Lizenzkauf"
msgstr "Licenties kopen"

msgid "Einlösungen und Lizenzzeiträume"
msgstr "Inwisselingen en licentieperiodes"

