msgid "Gutscheine & Aktionen"
msgstr "Kortingscodes en acties"

msgid "Rabatte und kostenlose Pro-Zeiträume sicher verwalten."
msgstr "Beheer kortingen en gratis Pro-periodes veilig."

msgid "+ Codes erstellen"
msgstr "+ Codes aanmaken"

msgid "Kampagnencodes"
msgstr "Actiecodes"

msgid "Erfolgreiche Einlösungen"
msgstr "Geslaagde inwisselingen"

msgid "Kampagne, Firma oder letzte vier Zeichen"
msgstr "Actie, bedrijf of laatste vier tekens"

msgid "Prozent"
msgstr "Percentage"

