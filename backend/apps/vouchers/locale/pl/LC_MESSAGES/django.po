msgstr "Udane realizacje"

msgid "Kampagne, Firma oder letzte vier Zeichen"
msgstr "Kampania, firma lub ostatnie cztery znaki"

msgid "Prozent"
msgstr "Procent"

msgid "Festbetrag"
msgstr "Stała kwota"

