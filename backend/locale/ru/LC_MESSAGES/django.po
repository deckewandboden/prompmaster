msgstr "SMTP 1 – Имя пользователя"

msgid "SMTP 1 – Passwort"
msgstr "SMTP 1 – Пароль"

msgid "SMTP 1 – Port"
msgstr "SMTP 1 – Порт"

msgid "SMTP 1 – STARTTLS verwenden"
msgstr "SMTP 1 – Использовать STARTTLS"

msgid "SMTP 1 – Server"
msgstr "SMTP 1 – Сервер"

msgid "SMTP 1, SMTP 2 und Microsoft Graph bleiben parallel konfiguriert."
msgstr "SMTP 1, SMTP 2 и Microsoft Graph остаются настроенными параллельно."

msgid "SMTP 2 – Benutzername"
msgstr "SMTP 2 – Имя пользователя"

msgid "SMTP 2 – Passwort"
msgstr "SMTP 2 – Пароль"

msgid "SMTP 2 – Port"
msgstr "SMTP 2 – Порт"

msgid "SMTP 2 – STARTTLS verwenden"
msgstr "SMTP 2 – Использовать STARTTLS"

msgid "SMTP 2 – Server"
msgstr "SMTP 2 – Сервер"

msgid "SPF Sollwert"
msgstr "Целевое значение SPF"

msgid "Support-Empfänger"
msgstr "Получатель запросов поддержки"

msgid "TXT-/CNAME-Sollwert oder beide Microsoft-365-DKIM-CNAMEs. Reine Dokumentation; DNS wird nicht automatisch verändert."
msgstr "Целевое значение TXT/CNAME или обе CNAME-записи DKIM Microsoft 365. Только документация; DNS не изменяется автоматически."

msgid "Verzeichnis-/Mandanten-ID des Microsoft-365-Tenants."
msgstr "Идентификатор каталога/арендатора Microsoft 365."

msgid "Zum Beispiel PROMPTFINISHER."
msgstr "Например, PROMPTFINISHER."

msgid "Zum Beispiel smtp.ionos.de."
msgstr "Например, smtp.ionos.de."

msgid "Das eigene netstyle Konto kann hier nicht deaktiviert werden."
msgstr "Здесь нельзя отключить свою учётную запись netstyle."

msgid "Der letzte aktive Superadmin kann nicht deaktiviert werden."
msgstr "Нельзя отключить последнего активного суперадминистратора."

msgid "Die eigene 2FA wird nicht über die Admin-Fremdverwaltung zurückgesetzt."
msgstr "Нельзя сбросить собственную 2FA через администрирование других пользователей."

msgid "2FA zurückgesetzt. Der Benutzer muss sie beim nächsten Login neu einrichten."
msgstr "2FA сброшена. Пользователь должен настроить её при следующем входе."

msgid "Die eigene Superadmin-Rolle kann nicht hier entfernt werden."
msgstr "Нельзя удалить собственную роль суперадминистратора здесь."

msgid "Die letzte aktive Superadmin-Berechtigung kann nicht entfernt werden."
msgstr "Нельзя удалить последнее активное право суперадминистратора."

msgid "Ein gesperrter Service Account kann nicht rotiert werden."
msgstr "Нельзя ротировать ключ заблокированной служебной учётной записи."

msgid "Mollie-Produktiv-Checkout wurde gesperrt."
msgstr "Рабочая касса Mollie заблокирована."

msgid "Bestätigung für die Erstattung fehlt."
msgstr "Отсутствует подтверждение возврата средств."

msgid "Erstattung wurde an Mollie übermittelt."
msgstr "Запрос на возврат отправлен в Mollie."

msgid "Für dieses Unternehmen existiert bereits ein aktiver Firmenadministrator."
msgstr "У этой компании уже есть активный администратор."

msgid "Dieser Benutzer ist bereits Firmenadministrator."
msgstr "Этот пользователь уже является администратором компании."

msgid "Ungültiger Supportstatus."
msgstr "Недопустимый статус обращения в поддержку."

msgid "Ungültiger Bearbeitungsstatus."
msgstr "Недопустимый статус обработки."

msgid "Bitte eine Antwort eingeben."
msgstr "Введите ответ."

msgid "Die Antwort darf höchstens 10.000 Zeichen enthalten."
msgstr "Ответ не должен превышать 10 000 символов."

msgid "Status aktualisiert."
msgstr "Статус обновлён."

msgid "Einstellungen gespeichert."
msgstr "Настройки сохранены."

msgid "Rolle gespeichert."
msgstr "Роль сохранена."

