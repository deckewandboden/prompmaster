FROM node:22-alpine AS marketing-build
WORKDIR /src
COPY marketing/package.json marketing/package-lock.json ./
# Optional local staging CA is available only to this RUN instruction as a
# BuildKit secret. The public source checkout and final runtime image stay clean.
# Without a supplied secret the default production/CI build is unchanged.
RUN --mount=type=secret,id=pf_staging_ca,required=false \
    if [ -f /run/secrets/pf_staging_ca ]; then \
      NODE_EXTRA_CA_CERTS=/run/secrets/pf_staging_ca \
      npm_config_cafile=/run/secrets/pf_staging_ca \
      npm_config_strict_ssl=true npm ci; \
    else \
      npm ci; \
    fi
COPY marketing/ ./
# Build-stage-only test fixture: the public marketing locale falls back to the
# actual Free/Pro localization asset, which is not part of marketing/.
# This file is intentionally not copied into the final Caddy image.
COPY backend/static/js/promptfinisher_product_i18n.20261011.js /backend/static/js/promptfinisher_product_i18n.20261011.js
# Build-stage-only version fixture to prevent stale translation caches.
# Never copied to the final Caddy runtime image.
COPY backend/apps/proaccess/views.py /backend/apps/proaccess/views.py
RUN npm test && npm run build

# Caddy 2.11.7 includes upstream HTTP/2/streaming repairs. The official
# 2.11.6-alpine image is retained only as the runtime filesystem; its
# bundled, vulnerable Caddy executable is replaced by this patched build.
FROM golang:1.26.10-alpine3.23 AS caddy-patched-build
ENV GOTOOLCHAIN=local
WORKDIR /src
RUN --mount=type=secret,id=pf_staging_ca,required=false \
    if [ -s /run/secrets/pf_staging_ca ]; then \
      cat /etc/ssl/cert.pem /run/secrets/pf_staging_ca > /tmp/pf-staging-ca-combined.pem; \
      export SSL_CERT_FILE=/tmp/pf-staging-ca-combined.pem; \
      export GIT_SSL_CAINFO=/tmp/pf-staging-ca-combined.pem; \
      export CURL_CA_BUNDLE=/tmp/pf-staging-ca-combined.pem; \
      trap 'rm -f /tmp/pf-staging-ca-combined.pem' EXIT; \
    fi; \
    printf '%s\n' \
      'package main' \
      'import (' \
      '    caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
      '    _ "github.com/caddyserver/caddy/v2/modules/standard"' \
      ')' \
      'func main() { caddycmd.Main() }' > main.go \
    && go mod init promptfinisher.local/caddy \
    && go get github.com/caddyserver/caddy/v2@v2.11.7 \
    && go get golang.org/x/net@v0.60.0 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/caddy . \
    && go version -m /out/caddy | grep -F 'go1.26.10' \
    && go version -m /out/caddy | grep -F 'golang.org/x/net' | grep -F 'v0.60.0'

FROM caddy:2.11.6-alpine
# The stable Alpine 3.23 repository currently ships curl/libcurl 8.22,
# vulnerable to CVE-2026-92392; the 8.23 fix is only on Alpine edge.
# This statically linked Caddy runtime does not use curl/libcurl: the
# production healthcheck uses BusyBox wget. Remove both unused packages
# instead of mixing unstable edge packages into a stable runtime.
# Keep the previously required fixed Brotli version fail-closed.
RUN apk del --no-cache curl libcurl \
    && apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0' \
    && ! apk info -e curl \
    && ! apk info -e libcurl
COPY --from=caddy-patched-build /out/caddy /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=marketing-build /src/dist /srv/marketing
