{
    admin off
    # This Caddy is reachable only from the existing front proxy's private
    # Docker network. Trust that proxy hop, parse X-Forwarded-For strictly,
    # then normalize the value passed to Django to one canonical client IP.
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
    }
}

# Internal-only health listener. It isn't published to a host port; Django and
# other containers on the edge network can probe Caddy without Docker socket access.
:8081 {
    respond /healthz 200
}

http://{$CADDY_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.mollie.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    request_body {
        max_size 10MB
    }

    # Do not let the SPA fallback turn probes for source/configuration files into HTTP 200.
    # ACME /.well-known remains untouched.
    @sensitive_source path /.env /.env/* /.env.example /.git /.git/* /.hg /.hg/* /.svn /.svn/* /.dockerignore /Dockerfile /Dockerfile.caddy /Dockerfile.validator /Caddyfile /Caddyfile.external /compose.yaml /compose.staging.yaml /compose.production.yaml /compose.external-caddy.yaml
    handle @sensitive_source {
        respond 404
    }

    # Compatibility routes from the recovered marketing frontend to the
    # canonical Django application routes. Use an explicit wildcard matcher so
    # the redirect target is never parsed as another path matcher, and preserve
    # the incoming query string (for example checkout quantity).
    handle /login* {
        redir * /auth/login/{?query} 302
    }
    handle /checkout* {
        redir * /portal/licenses/buy/{?query} 302
    }
    handle /app/pro* {
        redir * /pro/{?query} 302
    }
    handle /portal {
        redir * /portal/dashboard/{?query} 302
    }
    handle /portal/ {
        redir * /portal/dashboard/{?query} 302
    }

    # Public marketing aliases for versioned server-side legal documents.
    handle /datenschutz* {
        redir * /legal/privacy/{?query} 302
    }
    handle /agb* {
        redir * /legal/terms/{?query} 302
    }
    handle /lizenzbedingungen* {
        redir * /legal/license/{?query} 302
    }
    handle /widerruf* {
        redir * /legal/withdrawal/{?query} 302
    }

    handle /catalog.json {
        reverse_proxy promptmaster-web-internal:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
        }
    }

    # Mollie sends only a tiny form payload containing the provider payment ID.
    # Keep this public CSRF-exempt endpoint far below the general application
    # body ceiling to reduce parser/memory abuse before Django sees the request.
    handle /api/webhooks/mollie/ {
        request_body {
            max_size 64KB
        }
        reverse_proxy promptmaster-web-internal:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
        }
    }

    # Prometheus scrapes the web container directly. Never proxy internal
    # metrics from the public virtual host.
    handle /metrics/internal/* {
        respond 404
    }
    handle /api/v1/mcp* {
        respond 404
    }

    # V2 product assets use stable human-readable filenames because they are
    # injected into preserved Golden-Master HTML. They must therefore revalidate
    # instead of inheriting the one-year immutable policy used by fingerprinted
    # Django static assets.
    @mutable_product_static path /static/css/promptmaster_v2.20260922.css /static/js/promptmaster_ui_v2.20260922.js /static/js/free_catalog_bridge.20260918.js /static/brand/promptmaster-logo-clean.svg
    handle @mutable_product_static {
        uri strip_prefix /static
        root * /srv/static
        file_server
        header Cache-Control "no-cache, must-revalidate"
    }

    # Django collected static files.
    handle_path /static/* {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Server-side application surfaces. These routes are intentionally handled
    # before the static marketing fallback so authentication/licensing can
    # never be bypassed by a stale HTML file in marketing/dist.
    @django {
        path /auth /auth/* /free /free/* /free-old /free-old/* /pro /pro/* /pro-old /pro-old/* /portal/* /ns-admin /ns-admin/* /api /api/* /health/* /legal/*
    }
    handle @django {
        reverse_proxy promptmaster-web-internal:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
        }
    }

    # Public Marketing-/Vertriebsfrontend. marketing/dist is committed as a
    # deployable artifact and independently reproducible from marketing/src.
    handle {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }
    log
}